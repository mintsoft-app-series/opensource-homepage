---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import site from "../data/site.json";
import { t, prefix, otherLocale } from "../data/i18n";
import type { Locale } from "../data/projects";

interface Props { lang: Locale; title?: string; description?: string; path?: string }
const { lang, title, description, path = "/" } = Astro.props;
const d = t(lang);
const fullTitle = title ? `${title} · ${site.site.name}` : d.metaTitle;
const desc = description ?? d.metaDesc;
const canonical = new URL(prefix(lang) + path, site.site.url).href;
const alt = otherLocale(lang);
const altHref = new URL(prefix(alt) + path, site.site.url).href;
const koHref = new URL(path, site.site.url).href;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={lang} href={canonical} />
    <link rel="alternate" hreflang={alt} href={altHref} />
    <link rel="alternate" hreflang="x-default" href={koHref} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#0f9f6e" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL("/og.png", site.site.url).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,700&family=JetBrains+Mono:wght@400;600&display=swap" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />
    <script is:inline>
      try {
        const s = localStorage.getItem("theme");
        const dark = s ? s === "dark" : matchMedia("(prefers-color-scheme: dark)").matches;
        document.documentElement.classList.toggle("dark", dark);
      } catch {}
    </script>
  </head>
  <body class="min-h-dvh flex flex-col">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 bg-btn text-btn-text px-3 py-2 rounded-md">Skip</a>
    <Header lang={lang} path={path} />
    <main id="main" class="flex-1"><slot /></main>
    <Footer lang={lang} />
    <script>
      // 상대 시간 — 빌드 시점이 아니라 보는 시점 기준으로 계산한다.
      const rtf = (l: string) => new Intl.RelativeTimeFormat(l, { numeric: "auto" });
      document.querySelectorAll<HTMLTimeElement>("time[data-rel]").forEach((el) => {
        const diff = (new Date(el.dateTime).getTime() - Date.now()) / 1000;
        const units: [Intl.RelativeTimeFormatUnit, number][] = [["year", 31536000], ["month", 2592000], ["day", 86400], ["hour", 3600], ["minute", 60]];
        const [u, s] = units.find(([, s]) => Math.abs(diff) >= s) ?? ["minute", 60];
        el.textContent = rtf(document.documentElement.lang).format(Math.round(diff / s), u);
      });
      // 복사 버튼
      document.querySelectorAll<HTMLButtonElement>("button[data-copy]").forEach((b) => {
        b.addEventListener("click", async () => {
          try {
            await navigator.clipboard.writeText(b.dataset.copy ?? "");
            const label = b.querySelector("[data-label]");
            if (!label) return;
            const prev = label.textContent;
            label.textContent = b.dataset.copied ?? "Copied";
            setTimeout(() => (label.textContent = prev), 1500);
          } catch {}
        });
      });
    </script>
  </body>
</html>
