---
import LangBar from "./LangBar.astro";
import { t, prefix } from "../data/i18n";
import { repoMeta } from "../lib/repo";
import type { Project, Locale } from "../data/projects";
interface Props { p: Project; lang: Locale }
const { p, lang } = Astro.props;
const d = t(lang);
const m = repoMeta(p);
const live = p.status === "released";
const href = `${prefix(lang)}/projects/${p.slug}/`;
const Tag = live ? "a" : "div";
---
<Tag href={live ? href : undefined} data-cat={p.category}
  class:list={["group relative flex flex-col rounded-2xl border p-6 transition",
    live ? "border-line bg-page hover:border-mint/50 hover:shadow-lg hover:shadow-mint/5 hover:-translate-y-0.5"
         : "border-dashed border-line-strong bg-soft/50"]}>
  <div class="flex items-start justify-between gap-3">
    <div>
      <p class="font-mono text-[11px] text-sub">{p.repo}</p>
      <h3 class="mt-1 text-lg font-bold tracking-tight">{p.name}</h3>
    </div>
    <span class:list={["shrink-0 rounded-full px-2.5 py-0.5 text-[11px] font-semibold",
      live ? "bg-mint/10 text-mint-ink" : "bg-ink/5 text-sub"]}>
      {live ? d.cat[p.category] : d.preparing}
    </span>
  </div>
  <p class="mt-3 text-[15px] text-sub leading-relaxed">{p.tagline[lang]}</p>
  {!live && <p class="mt-2 text-xs text-sub/80">{d.preparingNote}</p>}
  <div class="mt-auto pt-6">
    {live && <LangBar meta={m} class="mb-4" />}
    <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-sub">
      {live && m && (
        <>
          <span class="inline-flex items-center gap-1"><svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.1 6.3 6.9 1-5 4.9 1.2 6.8L12 17.8 5.8 21l1.2-6.8-5-4.9 6.9-1z"/></svg>{m.stars}</span>
          <span>{m.license ?? d.noLicense}</span>
          <span class="inline-flex items-center gap-1.5"><span class="h-1.5 w-1.5 rounded-full bg-mint"></span>{d.lastCommit} <time data-rel datetime={m.pushedAt}>{m.pushedAt.slice(0, 10)}</time></span>
        </>
      )}
      {!live && p.tags?.map((tg) => <span class="font-mono">#{tg}</span>)}
    </div>
  </div>
</Tag>
