---
import site from "../data/site.json";
import { t, prefix, otherLocale } from "../data/i18n";
import { orgUrl } from "../lib/repo";
import type { Locale } from "../data/projects";
interface Props { lang: Locale; path: string }
const { lang, path } = Astro.props;
const d = t(lang);
const home = prefix(lang) + "/";
const alt = otherLocale(lang);
---
<header class="sticky top-0 z-40 border-b border-line bg-page/80 backdrop-blur-md">
  <div class="page-x flex h-16 items-center justify-between gap-4">
    <a href={home} class="inline-flex items-center gap-2.5 shrink-0">
      <img src="/logo.jpg" alt="" width="28" height="28" class="h-7 w-7 rounded-md" />
      <span class="font-logo text-[18px] font-bold tracking-[-0.025em]">MintSoft</span>
      <span class="hidden sm:inline font-mono text-[11px] font-semibold rounded-md border border-mint/40 text-mint-ink px-1.5 py-0.5">oss</span>
    </a>
    <nav class="flex items-center gap-1 text-sm">
      <a href={`${home}#projects`} class="hidden md:inline px-3 py-2 rounded-md text-sub hover:text-ink">{d.navProjects}</a>
      <a href={`${home}#contribute`} class="hidden md:inline px-3 py-2 rounded-md text-sub hover:text-ink">{d.navContribute}</a>
      <a href={site.site.appsUrl} class="hidden md:inline px-3 py-2 rounded-md text-sub hover:text-ink">{d.navApps} ↗</a>
      <a href={prefix(alt) + path} hreflang={alt} class="px-2.5 py-2 rounded-md font-mono text-xs text-sub hover:text-ink" aria-label={alt === "en" ? "English" : "한국어"}>{alt.toUpperCase()}</a>
      <button id="theme" type="button" class="p-2 rounded-md text-sub hover:text-ink" aria-label={d.toggleTheme}>
        <svg class="h-[18px] w-[18px] dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
        <svg class="h-[18px] w-[18px] hidden dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      </button>
      <a href={orgUrl} class="p-2 rounded-md text-sub hover:text-ink" aria-label="GitHub">
        <svg class="h-[18px] w-[18px]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5a11.5 11.5 0 0 0-3.6 22.4c.6.1.8-.3.8-.6v-2c-3.2.7-3.9-1.5-3.9-1.5-.5-1.3-1.3-1.7-1.3-1.7-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.7-1.6-2.6-.3-5.3-1.3-5.3-5.7 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.2 1.2a11 11 0 0 1 5.8 0C17.3 4.8 18.3 5 18.3 5c.6 1.6.2 2.8.1 3.1.8.8 1.2 1.9 1.2 3.1 0 4.4-2.7 5.4-5.3 5.7.4.4.8 1.1.8 2.2v3.2c0 .3.2.7.8.6A11.5 11.5 0 0 0 12 .5z"/></svg>
      </a>
    </nav>
  </div>
</header>
<script>
  document.getElementById("theme")?.addEventListener("click", () => {
    const dark = document.documentElement.classList.toggle("dark");
    try { localStorage.setItem("theme", dark ? "dark" : "light"); } catch {}
  });
</script>
