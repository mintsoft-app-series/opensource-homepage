---
// 시그니처 요소 — GitHub 식 언어 구성 막대. 카드·상세 공통.
import { languageShares, type RepoMeta } from "../lib/repo";
interface Props { meta?: RepoMeta; legend?: boolean; class?: string }
const { meta, legend = false, class: cls = "" } = Astro.props;
const shares = languageShares(meta);
---
{shares.length > 0 && (
  <div class={cls}>
    <div class="flex h-1.5 w-full overflow-hidden rounded-full bg-soft gap-px" role="img"
      aria-label={shares.map((s) => `${s.name} ${s.pct.toFixed(1)}%`).join(", ")}>
      {shares.map((s) => <span style={`width:${s.pct}%;background:${s.color}`} />)}
    </div>
    {legend && (
      <ul class="mt-3 flex flex-wrap gap-x-4 gap-y-1.5 text-xs text-sub">
        {shares.map((s) => (
          <li class="inline-flex items-center gap-1.5">
            <span class="h-2 w-2 rounded-full" style={`background:${s.color}`} />
            <span class="text-ink font-medium">{s.name}</span> {s.pct.toFixed(1)}%
          </li>
        ))}
      </ul>
    )}
  </div>
)}
