---
import Base from "../layouts/Base.astro";
import LangBar from "./LangBar.astro";
import CopyCommand from "./CopyCommand.astro";
import { t, prefix } from "../data/i18n";
import { repoMeta, repoUrl } from "../lib/repo";
import type { Project, Locale } from "../data/projects";
interface Props { p: Project; lang: Locale }
const { p, lang } = Astro.props;
const d = t(lang);
const m = repoMeta(p);
const url = repoUrl(p);
const dir = p.repo.split("/")[1];
const cmds = [`git clone ${url}.git`, `cd ${dir}`, ...(p.install ?? [])];
const facts = m ? [
  { l: d.stars, v: m.stars },
  { l: d.forks, v: m.forks },
  { l: d.openIssues, v: m.openIssues },
  { l: d.license, v: m.license ?? d.noLicense },
] : [];
---
<Base lang={lang} title={p.name} description={p.tagline[lang]} path={`/projects/${p.slug}/`}>
  <article class="page-x pt-12">
    <a href={`${prefix(lang)}/#projects`} class="text-sm text-sub hover:text-ink">{d.backToList}</a>
    <header class="mt-6 flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
      <div>
        <p class="font-mono text-xs text-sub">{p.repo}</p>
        <h1 class="mt-2 text-4xl sm:text-5xl font-extrabold tracking-[-0.03em]">{p.name}</h1>
        <p class="mt-4 max-w-2xl text-lg text-sub leading-relaxed">{p.tagline[lang]}</p>
      </div>
      <div class="flex flex-wrap gap-3">
        <a href={url} class="rounded-xl bg-btn text-btn-text px-5 py-3 text-sm font-semibold hover:opacity-90">{d.viewOnGithub} ↗</a>
        {p.homepage && <a href={p.homepage} class="rounded-xl border border-line-strong px-5 py-3 text-sm font-semibold hover:bg-soft">{d.homepage} ↗</a>}
      </div>
    </header>

    {facts.length > 0 && (
      <dl class="mt-10 grid grid-cols-2 sm:grid-cols-4 rounded-2xl border border-line divide-x divide-y sm:divide-y-0 divide-line overflow-hidden">
        {facts.map((f) => <div class="p-5"><dt class="text-xs text-sub">{f.l}</dt><dd class="mt-1 text-2xl font-bold tabular-nums">{f.v}</dd></div>)}
      </dl>
    )}

    <div class="mt-12 grid gap-12 lg:grid-cols-[1.4fr_1fr] [&>*]:min-w-0">
      <div class="space-y-12">
        <section>
          <p class="text-[17px] leading-relaxed">{p.description[lang]}</p>
        </section>
        {p.features?.[lang]?.length && (
          <section>
            <h2 class="text-xl font-bold">{d.features}</h2>
            <ul class="mt-4 space-y-2.5">
              {p.features[lang].map((f) => <li class="flex gap-3"><span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-mint"></span><span>{f}</span></li>)}
            </ul>
          </section>
        )}
        <section>
          <h2 class="text-xl font-bold">{d.getStarted}</h2>
          <div class="mt-4"><CopyCommand lines={cmds} copy={d.copy} copied={d.copied} /></div>
        </section>
      </div>
      <aside class="space-y-8">
        {m && (
          <section class="rounded-2xl border border-line p-6">
            <h2 class="text-sm font-semibold">{d.languages}</h2>
            <LangBar meta={m} legend class="mt-4" />
            <p class="mt-6 text-xs text-sub">{d.lastCommit} <time data-rel datetime={m.pushedAt}>{m.pushedAt.slice(0, 10)}</time></p>
          </section>
        )}
        {m?.latestRelease && (
          <a href={m.latestRelease.url} class="block rounded-2xl border border-line p-6 hover:border-mint/50">
            <h2 class="text-sm font-semibold">{d.latestRelease}</h2>
            <p class="mt-2 font-mono text-lg text-mint-ink">{m.latestRelease.tag}</p>
            <p class="mt-1 text-xs text-sub"><time data-rel datetime={m.latestRelease.publishedAt}>{m.latestRelease.publishedAt.slice(0, 10)}</time></p>
          </a>
        )}
        {p.tags?.length && <p class="flex flex-wrap gap-2">{p.tags.map((tg) => <span class="rounded-full bg-soft px-3 py-1 font-mono text-xs text-sub">#{tg}</span>)}</p>}
      </aside>
    </div>
  </article>
</Base>
